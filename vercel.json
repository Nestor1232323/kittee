{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "k7video.vercel.app"
        }
      ],
      "destination": "https://kittee-videos.vercel.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/kittee/videos/profile",
      "destination": "/api/v1/kittee/videos/profile"
    },
    {
      "source": "/api/v1/kittee/videos/history/add",
      "destination": "/api/v1/kittee/videos/profile?g=addhistory"
    },
    {
      "source": "/api/v1/kittee/videos/profile/get-subscribers",
      "destination": "/api/v1/kittee/videos/profile?g=getsub"
    },
    {
      "source": "/api/v1/kittee/videos/search/get_suggest",
      "destination": "/api/v1/kittee/videos/search/search?g=suggestions"
    },
    {
      "source": "/api/v1/kittee/videos/search/get_search",
      "destination": "/api/v1/kittee/videos/search/search?g=search"
    },
    {
      "source": "/api/v1/kittee/videos/profile/update-profile",
      "destination": "/api/v1/kittee/videos/profile?g=updateprofile"
    },
    {
      "source": "/",
      "destination": "/kittee-videos/index.html"
    }
  ]
}